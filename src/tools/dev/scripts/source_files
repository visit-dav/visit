#!/usr/bin/env bash

# List the files included in a VisIt source distribution.

set -o nounset
set -o pipefail

if (( $# != 0 )); then
    echo "USAGE: $0" >&2
    exit 1
fi

if [[ ! -d src ]]; then
    echo "Invoke $0 from the root of the VisIt source tree." >&2
    exit 1
fi

# These function names retain their historical meanings. In particular,
# get_git_norecursive uses git ls-tree -r, matching the original Perl script.
get_git_recursive()
{
    git ls-tree --name-only HEAD -- "$1"
}

get_git_norecursive()
{
    git ls-tree --name-only -r HEAD -- "$1"
}

get_ls_recursive()
{
    find "$1" -print
}

get_norecursive()
{
    local path

    for path in "$@"; do
        if [[ -e $path || -L $path ]]; then
            printf '%s\n' "$path"
        else
            # Match the old script's diagnostic for a missing file without
            # preventing the rest of the list from being generated.
            ls "$path"
        fi
    done

    return 0
}

list_all_files()
{
    get_git_norecursive  "./src"
    get_git_recursive    "./src/avt"
    get_git_recursive    "./src/bin"
    get_ls_recursive     "src/blt"
    get_git_recursive    "./src/CMake"
    get_git_recursive    "./src/common"
    get_git_recursive    "./src/config-site"
    get_git_recursive    "./src/databases"
    get_git_recursive    "./src/engine"
    get_git_recursive    "./src/gui"
    get_git_recursive    "./src/include"
    get_git_recursive    "./src/java"
    get_git_recursive    "./src/launcher"
    get_git_norecursive  "./src/lib"
    get_git_recursive    "./src/mdserver"
    get_git_recursive    "./src/operators"
    get_git_recursive    "./src/osxfixup"
    get_git_recursive    "./src/plots"
    get_git_recursive    "./src/plugins"
    get_git_recursive    "./src/resources"
    get_git_recursive    "./src/sim"
    get_git_recursive    "./src/test"
    get_git_recursive    "./src/third_party_builtin"
    get_git_recursive    "./src/tools"
    get_git_recursive    "./src/viewer"
    get_git_recursive    "./src/visit_vtk"
    get_git_recursive    "./src/visitpy"
    get_git_recursive    "./src/vtkqt"
    get_git_recursive    "./src/winutil"
    get_norecursive      "./src/GIT_VERSION"
    get_norecursive      "./scripts/run-build-visit"
    get_norecursive      "./scripts/visit-build"
    get_norecursive      "./scripts/visit-dist"
    get_norecursive      "./scripts/visit-install"
    get_norecursive      "./scripts/visit-install-run"
}

list_all_files | LC_ALL=C sort
