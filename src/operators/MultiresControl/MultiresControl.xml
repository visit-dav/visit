        Default_LOR
        Continuous_LOR
        Discontinuous_LOR
      </Enum>
      <Enum name="fieldProjectionMethod">
        Default_Projection
        Zonal_Projection
        Nodal_Projection
      </Enum>
      <Enum name="refinementBasisType">
        Gauss_Lobatto_Default
        Closed_Uniform
      </Enum>
      <Field name="resolution" label="" type="int">
        0
      </Field>
