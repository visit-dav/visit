ARG MANYLINUX_VERSION=2_28
FROM quay.io/pypa/manylinux_${MANYLINUX_VERSION}_x86_64 AS visit-build-environment

ENV ACLOCAL_PATH=/usr/share/aclocal

RUN dnf install -y \
      autoconf \
      automake \
      libtool \
      m4 \
      patch \
      git \
      wget \
      curl \
      cpio \
      unzip \
      python3 \
      perl \
      cmake \
      ninja-build \
      bison \
      flex \
      zlib-devel \
      libffi-devel \
      openssl-devel \
      freetype-devel \
      fontconfig \
      fontconfig-devel \
      libxml2 \
      libxml2-devel \
      libSM-devel \
      pkgconf \
      pkgconf-pkg-config \
      pkgconf-m4 \
   && dnf clean all \
   && which autoconf autom4te aclocal autoreconf \
   && rpm -ql pkgconf-m4 | grep /pkg.m4

RUN dnf install -y \
      libxcb \
      libxcb-devel \
      xcb-util \
      xcb-util-devel \
      xcb-util-image \
      xcb-util-image-devel \
      xcb-util-keysyms \
      xcb-util-keysyms-devel \
      xcb-util-renderutil \
      xcb-util-renderutil-devel \
      xcb-util-wm \
      xcb-util-wm-devel \
      xcb-proto \
      libxkbcommon \
      libxkbcommon-devel \
      libxkbcommon-x11 \
      libxkbcommon-x11-devel \
      libX11 \
      libX11-devel \
      libX11-xcb \
      libXext \
      libXext-devel \
      libXt-devel \
      libXrender-devel \
      libXfixes \
      libXfixes-devel \
      libXcursor \
      libXcursor-devel \
      xorg-x11-utils \
      xorg-x11-xkb-utils \
   && dnf clean all

RUN groupadd -r visit && useradd -ms /bin/bash --no-log-init -r -g visit visit
USER visit
WORKDIR /home/visit

COPY --chown=visit:visit build_visit[0-9]* /home/visit/
COPY --chown=visit:visit visit_version.py run_build_visit.py /home/visit/
RUN chmod +x build_visit[0-9]*

FROM visit-build-environment AS visit-release

RUN python3 run_build_visit.py
RUN python3 run_build_visit.py --optional

COPY --chown=visit:visit visit*.src.tar.gz /home/visit/
COPY --chown=visit:visit build_test_visit.py build_visit_docker_cleanup.py \
    test_visit.py /home/visit/

RUN python3 build_test_visit.py
RUN python3 build_visit_docker_cleanup.py
