ARG ROCKY_VERSION=8
FROM rockylinux:${ROCKY_VERSION}

LABEL org.opencontainers.image.title="VisIt Rocky Linux 8 runtime test"
LABEL org.opencontainers.image.description="GUI-capable Rocky Linux 8 test host for a packaged VisIt distribution"

RUN dnf --setopt=install_weak_deps=False install -y \
        binutils \
        bzip2 \
        cpio \
        dejavu-sans-fonts \
        file \
        findutils \
        gzip \
        glx-utils \
        fontconfig \
        freetype \
        libICE \
        libSM \
        libX11 \
        libX11-xcb \
        libXcursor \
        libXext \
        libXfixes \
        libXi \
        libXinerama \
        libXrandr \
        libXrender \
        libglvnd-glx \
        libglvnd-opengl \
        libxcb \
        libxkbcommon \
        libxkbcommon-x11 \
        mesa-libGL \
        mesa-dri-drivers \
        pcre2-utf16 \
        procps-ng \
        shadow-utils \
        tar \
        which \
        xorg-x11-utils \
        xcb-util \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm \
        xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN useradd --create-home --uid 1000 --shell /bin/bash visit-test \
    && mkdir -p /artifacts /opt/visit /results /work \
    && chown -R visit-test:visit-test /opt/visit /results /work

COPY --chown=visit-test:visit-test common/ /opt/visit-test/
RUN chmod 0755 /opt/visit-test/bin/*.sh \
    && chmod 0644 /opt/visit-test/lib/*.sh \
        /opt/visit-test/tests/*.py \
        /opt/visit-test/data/*

ENV VISIT_TEST_IMAGE_REVISION=12 \
    VISIT_TEST_PROFILE=rocky8 \
    VISIT_ROOT=/opt/visit \
    VISIT_ARTIFACT_DIR=/artifacts \
    VISIT_RESULTS_DIR=/results \
    VISIT_TEST_ROOT=/opt/visit-test \
    VISIT_GLIBC_BASELINE=2.28 \
    VISIT_TEST_TIMEOUT=120 \
    HOME=/home/visit-test \
    TMPDIR=/work/tmp

USER visit-test
WORKDIR /work

ENTRYPOINT ["/opt/visit-test/bin/run-tests.sh"]
CMD ["core"]
