ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV TZ=America/Los_Angeles
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    unzip \
    build-essential \
    gcc \
    g++ \
    gfortran \
    libssl-dev \
    python3 \
    libxrender1 \
    libxrender-dev \
    libxcb1 \
    libxcb1-dev \
    libxcb-cursor0 \
    libxcb-cursor-dev \
    libxcb-render0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-shape0-dev \
    libxcb-randr0 \
    libxcb-randr0-dev \
    libxcb-xfixes0-dev \
    libxcb-xkb1 \
    libxcb-xkb-dev \
    libxcb-sync1 \
    libxcb-sync-dev \
    libxcb-shm0 \
    libxcb-shm0-dev \
    libxcb-icccm4 \
    libxcb-icccm4-dev \
    libxcb-keysyms1 \
    libxcb-keysyms1-dev \
    libxcb-image0 \
    libxcb-image0-dev \
    libxcb-util1 \
    libxcb-util-dev \
    libxcb-xinerama0-dev \
    libxcb-glx0-dev \
    libxcb-dri2-0-dev \
    libxkbcommon0 \
    libxkbcommon-dev \
    libxkbcommon-x11-0 \
    libxkbcommon-x11-dev \
    libx11-6 \
    libx11-dev \
    libx11-xcb1 \
    libx11-xcb-dev \
    libxfixes-dev \
    libfontconfig1 \
    libfontconfig1-dev \
    libfreetype6 \
    libfreetype6-dev \
    libxext6 \
    libxext-dev \
    libsm6 \
    libice6 \
    libglib2.0-0 \
    libxi-dev \
    xorg-dev \
    autoconf \
    libtool \
    m4 \
    automake \
    libxml2 \
    libxml2-dev \
    vim \
    cpio \
    liblapack-dev \
    libffi-dev \
    locales \
 && rm -rf /var/lib/apt/lists/* \
 && localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8
ENV LANG=en_US.utf8

RUN cd /usr/include && ln -s freetype2 freetype

RUN groupadd -r visit && useradd -ms /bin/bash --no-log-init -r -g visit visit
USER visit
WORKDIR /home/visit

COPY --chown=visit:visit build_visit[0-9]* /home/visit/
COPY --chown=visit:visit visit_version.py run_build_visit.py \
    build_visit_docker_cleanup.py /home/visit/

RUN chmod +x build_visit[0-9]*
RUN python3 run_build_visit.py
RUN python3 build_visit_docker_cleanup.py

COPY --chown=visit:visit visit*.src.tar.gz /home/visit/
COPY --chown=visit:visit build_test_visit.py test_visit.py /home/visit/
RUN python3 build_test_visit.py
