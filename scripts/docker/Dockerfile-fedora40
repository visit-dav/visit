FROM fedora:40

# fetch build env
ENV TZ=America/Los_Angeles
RUN dnf -y upgrade && dnf -y install \
    git \
    wget \
    bzip2 \
    unzip \
    xz \
    patch \
    hostname \
    gcc \
    gcc-c++ \
    gcc-gfortran \
    make \
    zlib-devel \
    python3 \
    libX11* \
    libX11-* \
    libXrender \
    libXrender-devel \
    xcb* \
    xcb-* \
    libxcb* \
    libxcb-* \
    xcb-util \
    xcb-util-devel \
    xcb-util-keysyms \
    xcb-util-image \
    xcb-util-cursor \
    xcb-util-renderutil-devel \
    libxcb-devel \
    libxkbcommon-x11 \
    libxkbcommon-x11-devel \
    libxkbcommon-devel \
    libXext-devel \
    libXfixes-devel \
    libXi-devel \
    libXt-devel \
    fontconfig \
    fontconfig-devel \
    freetype-devel \
    autoconf \
    libtool \
    libxml2 \
    libxml2-devel \
    vim \
    cpio \
    openssl-devel \
    expat \
    expat-devel \
    perl \
 && rm -rf /var/lib/apt/lists/*

RUN dnf -y upgrade && dnf -y install libffi-devel && rm -rf /var/lib/apt/lists/*

RUN cd /usr/include && ln -s freetype2 freetype

RUN groupadd -r visit && useradd -ms /bin/bash --no-log-init -r -g visit visit
USER visit
WORKDIR /home/visit

# Build the third-party libraries before copying the source archive so that a
# new source archive does not invalidate this expensive Docker cache layer.
COPY --chown=visit:visit build_visit[0-9]* /home/visit/
COPY --chown=visit:visit visit_version.py run_build_visit.py \
    build_visit_docker_cleanup.py /home/visit/
RUN chmod +x build_visit[0-9]*
RUN python3 run_build_visit.py
RUN python3 build_visit_docker_cleanup.py

# Build, package, install, and test VisIt.
COPY --chown=visit:visit visit*.src.tar.gz /home/visit/
COPY --chown=visit:visit build_test_visit.py test_visit.py /home/visit/
RUN python3 build_test_visit.py
