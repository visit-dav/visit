#!/usr/bin/env bash

# Package the VisIt source tree for distribution.

set -o errexit
set -o nounset
set -o pipefail

usage()
{
    cat <<EOF
USAGE: $0 version

version may use '.' or '_' separators (for example, 3.6.0 or 3_6_0).
EOF
}

if (( $# == 1 )) && [[ $1 == -h || $1 == --help ]]; then
    usage
    exit 0
fi

if (( $# != 1 )); then
    echo "A version argument is required." >&2
    usage >&2
    exit 1
fi

if [[ ! -d src ]]; then
    echo "Invoke $0 from the root of the VisIt source tree." >&2
    usage >&2
    exit 1
fi

version_arg=$1
if [[ ! $version_arg =~ ^[0-9]+([._][0-9]+){2}$ ]]; then
    echo "Invalid version: '$version_arg'" >&2
    usage >&2
    exit 1
fi

version=${version_arg//./_}
dist_dir="visit${version}"
archive="visit${version}.src.tar.gz"
file_list=$(mktemp /tmp/visit-dist.XXXXXX)
archive_tmp=""
dist_created=false
git_version_existed=false
git_version_backup=""

cleanup()
{
    status=$?

    rm -f -- "$file_list"
    if [[ -n $archive_tmp ]]; then
        rm -f -- "$archive_tmp"
    fi
    if $dist_created; then
        rm -rf -- "$dist_dir"
    fi

    if $git_version_existed; then
        mv -- "$git_version_backup" src/GIT_VERSION
    else
        rm -f -- src/GIT_VERSION
    fi

    exit "$status"
}
trap cleanup EXIT

if [[ -e src/GIT_VERSION ]]; then
    git_version_existed=true
    git_version_backup=$(mktemp /tmp/visit-git-version.XXXXXX)
    cp -- src/GIT_VERSION "$git_version_backup"
fi

git rev-parse --short=10 HEAD > src/GIT_VERSION

echo "Getting the list of files to package up..."
./src/tools/dev/scripts/source_files > "$file_list"

if [[ -e $dist_dir ]]; then
    echo "Unable to create distribution subdirectory '$dist_dir': it already exists." >&2
    exit 1
fi

echo "Creating distribution..."
mkdir -m 0755 -- "$dist_dir"
dist_created=true
cpio -pmud "$dist_dir" < "$file_list"
chmod -Rf u+w -- "$dist_dir"

archive_tmp=$(mktemp "./.${archive}.XXXXXX")
tar cf - "$dist_dir" | gzip > "$archive_tmp"
chmod 0644 "$archive_tmp"
mv -f -- "$archive_tmp" "$archive"
archive_tmp=""

echo "Cleaning up..."
rm -rf -- "$dist_dir"
dist_created=false

echo "Finished."
echo "Your distribution is in the file '$archive'."
